<?xml version="1.0"?>
<robot name="t_motor_calibration_preview">
  <material name="motor_blue"><color rgba="0.45 0.65 0.95 0.45"/></material>
  <material name="black"><color rgba="0.02 0.02 0.02 1"/></material>
  <material name="red"><color rgba="1 0.05 0.05 1"/></material>
  <material name="green"><color rgba="0.05 0.8 0.05 1"/></material>
  <material name="blue"><color rgba="0.05 0.2 1 1"/></material>
  <material name="purple"><color rgba="0.55 0.0 0.8 1"/></material>
  <material name="orange"><color rgba="1.0 0.45 0.0 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 0.55"/></material>
  <link name="calibration_frame">
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><mesh filename="../../motor_model/T电机.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="motor_blue"/>
    </visual>
  </link>
  <link name="joint_origin_marker">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><sphere radius="0.007"/></geometry><material name="black"/></visual>
  </link>
  <joint name="joint_origin_marker_fixed" type="fixed"><parent link="calibration_frame"/><child link="joint_origin_marker"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="x_axis_red">
    <visual><origin xyz="0.07 0 0" rpy="0 1.5707963267948966 0"/><geometry><cylinder radius="0.003" length="0.14"/></geometry><material name="red"/></visual>
  </link>
  <joint name="x_axis_fixed" type="fixed"><parent link="calibration_frame"/><child link="x_axis_red"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="y_axis_green_child_direction">
    <visual><origin xyz="0 0.07 0" rpy="-1.5707963267948966 0 0"/><geometry><cylinder radius="0.003" length="0.14"/></geometry><material name="green"/></visual>
  </link>
  <joint name="y_axis_fixed" type="fixed"><parent link="calibration_frame"/><child link="y_axis_green_child_direction"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="z_axis_blue_joint_axis_candidate_A">
    <visual><origin xyz="0 0 0.07" rpy="0 0 0"/><geometry><cylinder radius="0.003" length="0.14"/></geometry><material name="blue"/></visual>
  </link>
  <joint name="z_axis_fixed" type="fixed"><parent link="calibration_frame"/><child link="z_axis_blue_joint_axis_candidate_A"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="parent_point_purple">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><sphere radius="0.006"/></geometry><material name="purple"/></visual>
  </link>
  <joint name="parent_point_fixed" type="fixed"><parent link="calibration_frame"/><child link="parent_point_purple"/><origin xyz="0 0 -0.075" rpy="0 0 0"/></joint>
  <link name="parent_direction_purple_minus_z">
    <visual><origin xyz="0 0 -0.095" rpy="0 0 0"/><geometry><cylinder radius="0.0035" length="0.04"/></geometry><material name="purple"/></visual>
  </link>
  <joint name="parent_direction_fixed" type="fixed"><parent link="calibration_frame"/><child link="parent_direction_purple_minus_z"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="child_point_orange">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><sphere radius="0.006"/></geometry><material name="orange"/></visual>
  </link>
  <joint name="child_point_fixed" type="fixed"><parent link="calibration_frame"/><child link="child_point_orange"/><origin xyz="0 0.075 0" rpy="0 0 0"/></joint>
  <link name="child_direction_orange_plus_y">
    <visual><origin xyz="0 0.095 0" rpy="-1.5707963267948966 0 0"/><geometry><cylinder radius="0.0035" length="0.04"/></geometry><material name="orange"/></visual>
  </link>
  <joint name="child_direction_fixed" type="fixed"><parent link="calibration_frame"/><child link="child_direction_orange_plus_y"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="alternate_axis_y_grey">
    <visual><origin xyz="0 -0.035 0" rpy="-1.5707963267948966 0 0"/><geometry><cylinder radius="0.002" length="0.07"/></geometry><material name="grey"/></visual>
  </link>
  <joint name="alternate_axis_y_fixed" type="fixed"><parent link="calibration_frame"/><child link="alternate_axis_y_grey"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
</robot>
