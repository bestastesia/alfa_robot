<?xml version="1.0"?>
<robot name="{{ robot.name }}">
  <material name="left_blue"><color rgba="{{ arms.left.color | join(' ') }}"/></material>
  <material name="right_orange"><color rgba="{{ arms.right.color | join(' ') }}"/></material>
  <material name="grey"><color rgba="0.55 0.55 0.55 1.0"/></material>

  <link name="{{ robot.root_link }}"/>

{% for side_name, arm in arms.items() %}
  <link name="{{ arm.prefix }}_link0">
{{ inertial_xml(links.link0, arm.mirror_y, 4) }}
  </link>
  <joint name="{{ arm.prefix }}_mount" type="fixed">
    <parent link="{{ mount.parent_link }}"/>
    <child link="{{ arm.prefix }}_link0"/>
    <origin xyz="{{ xyz(mount[side_name + '_xyz']) }}" rpy="{{ xyz(mount.rpy) }}"/>
  </joint>

{% for index in range(1, 7) %}
{% set link_key = 'link' ~ index %}
{% set joint_key = 'joint' ~ index %}
{% set joint = kinematics[joint_key] %}
  <link name="{{ arm.prefix }}_link{{ index }}">
{{ inertial_xml(links[link_key], arm.mirror_y, 4) }}
{% if visual.use_primitives %}
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="{{ visual.joint_radius }}" length="{{ visual.link_length }}"/></geometry>
      <material name="{{ 'left_blue' if side_name == 'left' else 'right_orange' }}"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="{{ visual.joint_radius }}" length="{{ visual.link_length }}"/></geometry>
    </collision>
{% endif %}
  </link>
  <joint name="{{ arm.prefix }}_joint{{ index }}" type="revolute">
    <parent link="{{ arm.prefix }}_link{{ index - 1 }}"/>
    <child link="{{ arm.prefix }}_link{{ index }}"/>
    <origin xyz="{{ joint_xyz(joint, arm.mirror_y) }}" rpy="{{ joint_rpy(joint, arm.mirror_y) }}"/>
    <axis xyz="{{ xyz(joint.axis) }}"/>
    <limit lower="{{ joint.limit[0] }}" upper="{{ joint.limit[1] }}" effort="{{ joint.effort }}" velocity="{{ joint.velocity }}"/>
  </joint>

{% endfor %}
  <link name="{{ arm.prefix }}_tool0">
{{ inertial_xml(links.tool0, arm.mirror_y, 4) }}
{% if visual.use_primitives %}
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.04"/></geometry>
      <material name="grey"/>
    </visual>
{% endif %}
  </link>
  <joint name="{{ arm.prefix }}_tool0_fixed" type="fixed">
    <parent link="{{ arm.prefix }}_link6"/>
    <child link="{{ arm.prefix }}_tool0"/>
    <origin xyz="{{ xyz(kinematics.tool0_fixed.xyz) }}" rpy="{{ xyz(kinematics.tool0_fixed.rpy) }}"/>
  </joint>

{% endfor %}
</robot>
