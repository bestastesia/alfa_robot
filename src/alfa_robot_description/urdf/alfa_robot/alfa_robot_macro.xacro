<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:include filename="$(find alfa_robot_description)/urdf/common/inertials.xacro"/>
  <xacro:include filename="$(find alfa_robot_description)/urdf/common/materials.xacro"/>

  <xacro:macro name="alfa_robot" params="prefix parent *origin">
    <!-- LINKS -->
    <!-- base_link -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="3.7315E-08 -7.4812E-06 0.017979" rpy="0 0 0"/>
        <mass value="11.681"/>
        <inertia ixx="0.33161" ixy="0" ixz="0" iyy="0.33161" iyz="0" izz="0.6611"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://alfa_robot_description/meshes/alfa_robot/visual/base.STL"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://alfa_robot_description/meshes/alfa_robot/collision/base.STL"/>
        </geometry>
      </collision>
    </link>

    <!-- turn (link name differs from joint for GZ compatibility) -->
    <link name="${prefix}turn_link">
      <inertial>
        <origin xyz="-5.4556E-05 0.094864 0.74374" rpy="0 0 0"/>
        <mass value="52.536"/>
        <inertia ixx="10.303" ixy="0" ixz="0" iyy="10.345" iyz="0" izz="1.0442"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://alfa_robot_description/meshes/alfa_robot/visual/turn.STL"/>
        </geometry>
        <material name="arm_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://alfa_robot_description/meshes/alfa_robot/collision/turn.STL"/>
        </geometry>
      </collision>
    </link>

    <!-- updown (link name differs from joint for GZ compatibility) -->
    <link name="${prefix}updown_link">
      <inertial>
        <origin xyz="0.0201090104029969 0.0803972373261843 0.0984366062782738" rpy="0 0 0"/>
        <mass value="22.9526820845594"/>
        <inertia ixx="0.164263278076855" ixy="0" ixz="0" iyy="0.152416211091917" iyz="0" izz="0.278538027798598"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://alfa_robot_description/meshes/alfa_robot/visual/updown.STL"/>
        </geometry>
        <material name="arm_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://alfa_robot_description/meshes/alfa_robot/collision/updown.STL"/>
        </geometry>
      </collision>
    </link>

    <!-- leftarmbase (link name differs from joint for GZ compatibility) -->
    <link name="${prefix}leftarmbase_link">
      <inertial>
        <origin xyz="0.29757 -0.16382 0.17861" rpy="0 0 0"/>
        <mass value="18.562"/>
        <inertia ixx="0.79163" ixy="0" ixz="0" iyy="0.43754" iyz="0" izz="0.39477"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://alfa_robot_description/meshes/alfa_robot/visual/leftarmbase.STL"/>
        </geometry>
        <material name="white"/>
