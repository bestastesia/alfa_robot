<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="alfa_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import alfa_robot urdf file -->
    <xacro:include filename="$(find alfa_robot_description)/urdf/alfa_robot.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="alfa_robot.ros2_control.xacro" />


    <xacro:alfa_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
