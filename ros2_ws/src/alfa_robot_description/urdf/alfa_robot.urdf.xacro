<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="alfa_robot">

  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_mock_hardware" default="true"/>
  <xacro:arg name="mock_sensor_commands" default="false"/>
  <xacro:arg name="sim_gazebo_classic" default="false"/>
  <xacro:arg name="sim_gazebo" default="false"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="real_hardware_plugin" default="alfa_robot_hardware/AlfaRobotHW"/>
  <xacro:arg name="canopen_profile_velocity" default="50000"/>
  <xacro:arg name="canopen_profile_accel" default="50000"/>

  <xacro:include filename="$(find alfa_robot_description)/urdf/alfa_robot/alfa_robot_macro.ros2_control.xacro"/>

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>

  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-0.00896922200126715 2.35194162193642E-05 0.0179811176086975"
        rpy="0 0 0" />
      <mass
        value="5.21106238092598" />
      <inertia
        ixx="0.0633320335254252"
        ixy="-1.57025952749484E-07"
        ixz="-3.66796372424077E-07"
        iyy="0.119212913285128"
        iyz="6.33714518991059E-07"
        izz="0.181818429904202" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/visual/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/collision/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link
    name="pitch">
    <inertial>
      <origin
        xyz="-0.198797876667389 0.0534826037691441 0.0683908156328275"
        rpy="0 0 0" />
      <mass
        value="5.23479125794249" />
      <inertia
        ixx="0.0820011779740888"
        ixy="1.65869977323853E-10"
        ixz="-1.12757025938492E-17"
        iyy="0.0820529172807708"
        iyz="-2.38941055572563E-17"
        izz="0.163475256832643" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/visual/pitch.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/collision/pitch.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="pitch"
    type="revolute">
    <origin
      xyz="0.259 -0.0545 0.05"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="pitch" />
    <axis
      xyz="0 1 0" />
    <limit
      lower="0"
      upper="0.26"
      effort="0"
      velocity="0" />
  </joint>
  <link
    name="turn">
    <inertial>
      <origin
        xyz="-0.0279588381716878 3.16554382575607E-05 0.819951711254512"
        rpy="0 0 0" />
      <mass
        value="15.206613319806" />
      <inertia
        ixx="1.06710751132169"
        ixy="5.33982003477265E-06"
        ixz="0.000444527933425444"
        iyy="1.0606566000007"
        iyz="1.02603827456492E-05"
        izz="0.109926667915607" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/visual/turn.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/collision/turn.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="turn"
    type="continuous">
    <origin
      xyz="-0.209 0.0545 0.09"
      rpy="0 0 0" />
    <parent
      link="pitch" />
    <child
      link="turn" />
    <axis
      xyz="0 0 1" />
  </joint>
  <link
    name="updown">
    <inertial>
      <origin
        xyz="0.0212260463112321 -2.11665364142077E-05 0.111174833260946"
        rpy="0 0 0" />
      <mass
        value="8.56370936774335" />
      <inertia
        ixx="0.0416436910064672"
        ixy="-3.48369951311999E-07"
        ixz="1.03580898385951E-05"
        iyy="0.151229514406379"
        iyz="1.21565800186775E-06"
        izz="0.186025474834666" />
    </inertial>
    <!-- updown link remains the lift/mount frame, but its metal STL is intentionally hidden and non-colliding. -->
  </link>
  <joint
    name="updown"
    type="prismatic">
    <origin
      xyz="-0.1 0 0.086"
      rpy="0 0 0" />
    <parent
      link="turn" />
    <child
      link="updown" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="0"
      upper="0.99"
      effort="0"
      velocity="0" />
  </joint>
  <!-- v5 dual six-axis arms from the imported SolidWorks URDF.
       Source package snapshot: /mnt/mydisk/ALFA/alfa_robot/alfa_robot_arm_v5
       Current v5 proxy before replacement is preserved at:
       urdf/alfa_robot_v5_proxy_backup.urdf.xacro
       Naming is kept as left_v5_joint1..6 / right_v5_joint1..6 for MoveIt and ros2_control compatibility.
       The imported single-arm URDF contains motor1..motor6 and 5 internal joints; the mount joint is the added joint1. -->
  <xacro:property name="v5_mount_y" value="0.20"/>
  <xacro:property name="v5_mount_z" value="0.18"/>
  <xacro:property name="v5_mesh_base" value="package://alfa_robot_description/meshes/alfa_robot_arm_v5"/>

  <xacro:macro name="v5_simple_inertial" params="mass">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="v5_visual_mesh" params="mesh_dir mesh origin_xyz origin_rpy color">
    <visual>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <geometry><mesh filename="${v5_mesh_base}/${mesh_dir}/${mesh}"/></geometry>
      <material name="v5_imported_mesh_mat"><color rgba="${color}"/></material>
    </visual>
  </xacro:macro>

  <xacro:macro name="v5_collision_mesh" params="mesh_dir mesh origin_xyz origin_rpy">
    <collision>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <geometry><mesh filename="${v5_mesh_base}/${mesh_dir}/${mesh}"/></geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="v5_imported_motor_link" params="name motor color visual_dir collision_dir mirror_y:=1 include_visual:=true include_collision:=true">
    <link name="${name}">
      <xacro:if value="${motor == 'motor1'}">
        <inertial>
          <origin xyz="-0.00549007480040076 ${mirror_y * 4.41384348585649E-05} 0.0638192670583628" rpy="0 0 0"/>
          <mass value="1.14347754183273"/>
          <inertia ixx="0.00234577756970447" ixy="${mirror_y * -1.39192053258421E-06}" ixz="7.06941577680902E-05" iyy="0.00245440034346279" iyz="${mirror_y * -2.78529246638655E-06}" izz="0.00212775141233719"/>
        </inertial>
        <xacro:if value="${include_visual}">
          <xacro:v5_visual_mesh mesh_dir="${visual_dir}" mesh="motor1.STL" origin_xyz="0 0 0" origin_rpy="0 0 0" color="${color}"/>
        </xacro:if>
        <xacro:if value="${include_collision}">
          <xacro:v5_collision_mesh mesh_dir="${collision_dir}" mesh="motor1.STL" origin_xyz="0 0 0" origin_rpy="0 0 0"/>
        </xacro:if>
      </xacro:if>
      <xacro:if value="${motor == 'motor2'}">
        <inertial>
          <origin xyz="-2.09300645109267E-05 ${mirror_y * 0.300000037733846} -0.0739999978650945" rpy="0 0 0"/>
          <mass value="4.80591024170092"/>
          <inertia ixx="0.0514140216022789" ixy="${mirror_y * -1.11071009974064E-09}" ixz="7.00200352560243E-10" iyy="0.0109314943608357" iyz="${mirror_y * 0.000141378481768625}" izz="0.0507607430231609"/>
        </inertial>
        <xacro:if value="${include_visual}">
          <xacro:v5_visual_mesh mesh_dir="${visual_dir}" mesh="motor2.STL" origin_xyz="0 0 0" origin_rpy="0 0 0" color="${color}"/>
        </xacro:if>
        <xacro:if value="${include_collision}">
          <xacro:v5_collision_mesh mesh_dir="${collision_dir}" mesh="motor2.STL" origin_xyz="0 0 0" origin_rpy="0 0 0"/>
        </xacro:if>
      </xacro:if>
      <xacro:if value="${motor == 'motor3'}">
        <inertial>
          <origin xyz="-8.86583279652298E-06 ${mirror_y * -0.191421080971033} -0.0611928334493207" rpy="0 0 0"/>
          <mass value="5.53739421393496"/>
          <inertia ixx="0.0659171393206471" ixy="${mirror_y * -1.40894015322047E-06}" ixz="-2.83298512105713E-06" iyy="0.0102087351820484" iyz="${mirror_y * -0.00128557192119225}" izz="0.0652938482117856"/>
        </inertial>
        <xacro:if value="${include_visual}">
          <xacro:v5_visual_mesh mesh_dir="${visual_dir}" mesh="motor3.STL" origin_xyz="0 0 0" origin_rpy="0 0 0" color="${color}"/>
        </xacro:if>
        <xacro:if value="${include_collision}">
          <xacro:v5_collision_mesh mesh_dir="${collision_dir}" mesh="motor3.STL" origin_xyz="0 0 0" origin_rpy="0 0 0"/>
        </xacro:if>
      </xacro:if>
      <xacro:if value="${motor == 'motor4'}">
        <inertial>
          <origin xyz="0.054010017525899 ${mirror_y * -0.00968074438612282} -4.38885459771443E-05" rpy="0 0 0"/>
          <mass value="1.14347527972143"/>
          <inertia ixx="0.00234577526969165" ixy="${mirror_y * 7.06887224662317E-05}" ixz="1.39432827945232E-06" iyy="0.00212775138988867" iyz="${mirror_y * 2.78555789689753E-06}" izz="0.00245439599558472"/>
        </inertial>
        <xacro:if value="${include_visual}">
          <xacro:v5_visual_mesh mesh_dir="${visual_dir}" mesh="motor4.STL" origin_xyz="0 0 0" origin_rpy="0 0 0" color="${color}"/>
        </xacro:if>
        <xacro:if value="${include_collision}">
          <xacro:v5_collision_mesh mesh_dir="${collision_dir}" mesh="motor4.STL" origin_xyz="0 0 0" origin_rpy="0 0 0"/>
        </xacro:if>
      </xacro:if>
      <xacro:if value="${motor == 'motor5'}">
        <inertial>
          <origin xyz="-0.0545098970073398 ${mirror_y * -0.00968076621990099} 4.3968113340731E-05" rpy="0 0 0"/>
          <mass value="1.14347708247491"/>
          <inertia ixx="0.00234577450108908" ixy="${mirror_y * -7.0688725031574E-05}" ixz="1.39442681307563E-06" iyy="0.00212775140409106" iyz="${mirror_y * -2.78654985483454E-06}" izz="0.00245439718636663"/>
        </inertial>
        <xacro:if value="${include_visual}">
          <xacro:v5_visual_mesh mesh_dir="${visual_dir}" mesh="motor5.STL" origin_xyz="0 0 0" origin_rpy="0 0 0" color="${color}"/>
        </xacro:if>
        <xacro:if value="${include_collision}">
          <xacro:v5_collision_mesh mesh_dir="${collision_dir}" mesh="motor5.STL" origin_xyz="0 0 0" origin_rpy="0 0 0"/>
        </xacro:if>
      </xacro:if>
      <xacro:if value="${motor == 'motor6'}">
        <inertial>
          <origin xyz="0 0 0.056752" rpy="0 0 0"/>
          <mass value="8.2851"/>
          <inertia ixx="0.041557" ixy="0" ixz="0" iyy="0.063474" iyz="0" izz="0.099371"/>
        </inertial>
        <xacro:if value="${include_visual}">
          <xacro:v5_visual_mesh mesh_dir="${visual_dir}" mesh="motor6.STL" origin_xyz="0 0 0" origin_rpy="0 0 0" color="${color}"/>
        </xacro:if>
        <xacro:if value="${include_collision}">
          <xacro:v5_collision_mesh mesh_dir="${collision_dir}" mesh="motor6.STL" origin_xyz="0 0 0" origin_rpy="0 0 0"/>
        </xacro:if>
      </xacro:if>
    </link>
  </xacro:macro>

  <xacro:macro name="v5_imported_arm" params="side mount_y mirror_y color visual_dir collision_dir">
    <link name="${side}_v5_link0">
      <xacro:v5_simple_inertial mass="0.5"/>
    </link>
    <joint name="${side}_v5_mount" type="fixed">
      <parent link="updown"/>
      <child link="${side}_v5_link0"/>
      <origin xyz="0 ${mount_y} ${v5_mount_z}" rpy="0 0 0"/>
    </joint>

    <xacro:v5_imported_motor_link name="${side}_v5_link1" motor="motor1" color="${color}" visual_dir="${visual_dir}" collision_dir="${collision_dir}" mirror_y="${mirror_y}"/>
    <joint name="${side}_v5_joint1" type="revolute">
      <parent link="${side}_v5_link0"/>
      <child link="${side}_v5_link1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="120" velocity="1.2"/>
    </joint>

    <xacro:v5_imported_motor_link name="${side}_v5_link2" motor="motor2" color="${color}" visual_dir="${visual_dir}" collision_dir="${collision_dir}" mirror_y="${mirror_y}"/>
    <joint name="${side}_v5_joint2" type="revolute">
      <parent link="${side}_v5_link1"/>
      <child link="${side}_v5_link2"/>
      <origin xyz="-0.0595 0 0.0735" rpy="${mirror_y * 1.5708} 0 ${mirror_y * 1.5708}"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="120" velocity="1.2"/>
    </joint>

    <xacro:v5_imported_motor_link name="${side}_v5_link3" motor="motor3" color="${color}" visual_dir="${visual_dir}" collision_dir="${collision_dir}" mirror_y="${mirror_y}"/>
    <joint name="${side}_v5_joint3" type="revolute">
      <parent link="${side}_v5_link2"/>
      <child link="${side}_v5_link3"/>
      <origin xyz="0 ${mirror_y * 0.6} -0.148" rpy="0 0 ${mirror_y * 3.1416}"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="100" velocity="1.2"/>
    </joint>

    <xacro:v5_imported_motor_link name="${side}_v5_link4" motor="motor4" color="${color}" visual_dir="${visual_dir}" collision_dir="${collision_dir}" mirror_y="${mirror_y}"/>
    <joint name="${side}_v5_joint4" type="revolute">
      <parent link="${side}_v5_link3"/>
      <child link="${side}_v5_link4"/>
      <origin xyz="0 ${mirror_y * -0.412} 0.009" rpy="${mirror_y * 1.5708} -1.5708 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="60" velocity="1.5"/>
    </joint>

    <xacro:v5_imported_motor_link name="${side}_v5_link5" motor="motor5" color="${color}" visual_dir="${visual_dir}" collision_dir="${collision_dir}" mirror_y="${mirror_y}"/>
    <joint name="${side}_v5_joint5" type="revolute">
      <parent link="${side}_v5_link4"/>
      <child link="${side}_v5_link5"/>
      <origin xyz="0.0595 ${mirror_y * -0.074} 0" rpy="${mirror_y * -1.5708} 0 ${mirror_y * 1.5708}"/>
      <axis xyz="1 0 0"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="60" velocity="1.5"/>
    </joint>

    <xacro:v5_imported_motor_link name="${side}_v5_link6" motor="motor6" color="${color}" visual_dir="${visual_dir}" collision_dir="${collision_dir}" mirror_y="${mirror_y}"/>
    <joint name="${side}_v5_joint6" type="revolute">
      <parent link="${side}_v5_link5"/>
      <child link="${side}_v5_link6"/>
      <origin xyz="-0.06 ${mirror_y * -0.074} 0" rpy="${mirror_y * 1.5708} 0 0"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="40" velocity="1.5"/>
    </joint>

    <link name="${side}_v5_tool0">
      <xacro:v5_simple_inertial mass="0.2"/>
    </link>
    <joint name="${side}_v5_tool0_fixed" type="fixed">
      <parent link="${side}_v5_link6"/>
      <child link="${side}_v5_tool0"/>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:v5_imported_arm side="left" mount_y="${v5_mount_y}" mirror_y="1" color="0.2 0.55 1.0 1" visual_dir="visual" collision_dir="collision"/>
  <xacro:v5_imported_arm side="right" mount_y="${-v5_mount_y}" mirror_y="-1" color="1.0 0.55 0.2 1" visual_dir="visual_right" collision_dir="collision_right"/>

  <xacro:alfa_robot_ros2_control
    name="alfa_robot"
    prefix="$(arg prefix)"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"
    sim_gazebo_classic="$(arg sim_gazebo_classic)"
    sim_gazebo="$(arg sim_gazebo)"
    simulation_controllers="$(arg simulation_controllers)"
    real_hardware_plugin="$(arg real_hardware_plugin)"
    canopen_profile_velocity="$(arg canopen_profile_velocity)"
    canopen_profile_accel="$(arg canopen_profile_accel)"/>

</robot>
