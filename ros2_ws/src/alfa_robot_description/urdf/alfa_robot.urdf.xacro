<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="alfa_robot">

  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_mock_hardware" default="true"/>
  <xacro:arg name="mock_sensor_commands" default="false"/>
  <xacro:arg name="sim_gazebo_classic" default="false"/>
  <xacro:arg name="sim_gazebo" default="false"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="real_hardware_plugin" default="alfa_robot_hardware/AlfaRobotHW"/>
  <xacro:arg name="canopen_profile_velocity" default="50000"/>
  <xacro:arg name="canopen_profile_accel" default="50000"/>

  <xacro:include filename="$(find alfa_robot_description)/urdf/alfa_robot/alfa_robot_macro.ros2_control.xacro"/>

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>

  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-0.00896922200126715 2.35194162193642E-05 0.0179811176086975"
        rpy="0 0 0" />
      <mass
        value="5.21106238092598" />
      <inertia
        ixx="0.0633320335254252"
        ixy="-1.57025952749484E-07"
        ixz="-3.66796372424077E-07"
        iyy="0.119212913285128"
        iyz="6.33714518991059E-07"
        izz="0.181818429904202" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/visual/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/collision/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link
    name="pitch">
    <inertial>
      <origin
        xyz="-0.198797876667389 0.0534826037691441 0.0683908156328275"
        rpy="0 0 0" />
      <mass
        value="5.23479125794249" />
      <inertia
        ixx="0.0820011779740888"
        ixy="1.65869977323853E-10"
        ixz="-1.12757025938492E-17"
        iyy="0.0820529172807708"
        iyz="-2.38941055572563E-17"
        izz="0.163475256832643" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/visual/pitch.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/collision/pitch.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="pitch"
    type="revolute">
    <origin
      xyz="0.259 -0.0545 0.05"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="pitch" />
    <axis
      xyz="0 1 0" />
    <limit
      lower="0"
      upper="0.26"
      effort="0"
      velocity="0" />
  </joint>
  <link
    name="turn">
    <inertial>
      <origin
        xyz="-0.0279588381716878 3.16554382575607E-05 0.819951711254512"
        rpy="0 0 0" />
      <mass
        value="15.206613319806" />
      <inertia
        ixx="1.06710751132169"
        ixy="5.33982003477265E-06"
        ixz="0.000444527933425444"
        iyy="1.0606566000007"
        iyz="1.02603827456492E-05"
        izz="0.109926667915607" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/visual/turn.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/collision/turn.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="turn"
    type="continuous">
    <origin
      xyz="-0.209 0.0545 0.09"
      rpy="0 0 0" />
    <parent
      link="pitch" />
    <child
      link="turn" />
    <axis
      xyz="0 0 1" />
  </joint>
  <link
    name="updown">
    <inertial>
      <origin
        xyz="0.0212260463112321 -2.11665364142077E-05 0.111174833260946"
        rpy="0 0 0" />
      <mass
        value="8.56370936774335" />
      <inertia
        ixx="0.0416436910064672"
        ixy="-3.48369951311999E-07"
        ixz="1.03580898385951E-05"
        iyy="0.151229514406379"
        iyz="1.21565800186775E-06"
        izz="0.186025474834666" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/visual/updown.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/collision/updown.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="updown"
    type="prismatic">
    <origin
      xyz="-0.1 0 0.086"
      rpy="0 0 0" />
    <parent
      link="turn" />
    <child
      link="updown" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="0"
      upper="0.99"
      effort="0"
      velocity="0" />
  </joint>
  <!-- v5 dual six-axis proxy arms.
       Coordinate convention for this proxy: +Y is forward, +Z is up.
       User-corrected mounting plane: both mount frames use x=0, so they lie in the same YZ plane as updown.
       The two proxy arms are separated along +/-Y and use multi-primitive T-motor joint visuals. -->
  <xacro:property name="v5_mount_y" value="0.32"/>
  <xacro:property name="v5_mount_z" value="0.18"/>
  <xacro:property name="v5_upper_arm_length" value="0.65"/>
  <xacro:property name="v5_forearm_length" value="0.65"/>
  <xacro:property name="v5_motor_radius" value="0.085"/>
  <xacro:property name="v5_motor_width" value="0.11"/>
  <xacro:property name="v5_motor_gap" value="0"/>
  <xacro:property name="v5_joint1_zero_rpy" value="0 0 -1.5708"/>

  <xacro:macro name="v5_visual_box" params="size xyz rpy color">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><box size="${size}"/></geometry>
      <material name="v5_box_mat"><color rgba="${color}"/></material>
    </visual>
  </xacro:macro>

  <xacro:macro name="v5_collision_box" params="size xyz rpy">
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><box size="${size}"/></geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="v5_visual_cylinder" params="radius length xyz rpy color">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      <material name="v5_cylinder_mat"><color rgba="${color}"/></material>
    </visual>
  </xacro:macro>

  <xacro:macro name="v5_collision_cylinder" params="radius length xyz rpy">
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="v5_simple_inertial" params="mass">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="v5_t_motor_mesh_visual" params="xyz rpy color">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry>
        <mesh filename="package://alfa_robot_description/meshes/alfa_robot_v2_arm_v4_new/visual/leftjoint4.STL"/>
      </geometry>
      <material name="v5_t_motor_mesh_mat"><color rgba="${color}"/></material>
    </visual>
  </xacro:macro>

  <xacro:macro name="v5_t_motor_link" params="name axis mass color">
    <link name="${name}">
      <xacro:v5_simple_inertial mass="${mass}"/>
      <xacro:if value="${axis == 'z'}">
        <!-- Visual uses leftjoint4.STL as the T-motor template; collision stays primitive for MoveIt stability. -->
        <xacro:v5_t_motor_mesh_visual xyz="0 0 0" rpy="0 0 0" color="${color}"/>
        <xacro:v5_collision_cylinder radius="${v5_motor_radius}" length="${v5_motor_width}" xyz="0 0 0.05" rpy="0 0 0"/>
      </xacro:if>
      <xacro:if value="${axis == 'x'}">
        <xacro:v5_t_motor_mesh_visual xyz="0 0 0" rpy="0 1.5708 0" color="${color}"/>
        <xacro:v5_collision_cylinder radius="${v5_motor_radius}" length="${v5_motor_width}" xyz="0.05 0 0" rpy="0 1.5708 0"/>
      </xacro:if>
      <xacro:if value="${axis == 'y'}">
        <xacro:v5_t_motor_mesh_visual xyz="0 0 0" rpy="1.5708 0 0" color="${color}"/>
        <xacro:v5_collision_cylinder radius="${v5_motor_radius}" length="${v5_motor_width}" xyz="0 0.05 0" rpy="1.5708 0 0"/>
      </xacro:if>
    </link>
  </xacro:macro>

  <xacro:macro name="v5_t_motor_with_bar_link" params="name axis bar_length bar_radius mass color">
    <link name="${name}">
      <xacro:v5_simple_inertial mass="${mass}"/>
      <xacro:if value="${axis == 'x'}">
        <xacro:v5_t_motor_mesh_visual xyz="0.06 -0.0 0" rpy="3.141592654 1.5708 0" color="${color}"/>
        <xacro:v5_collision_cylinder radius="${v5_motor_radius}" length="${v5_motor_width}" xyz="0.05 0 0" rpy="0 1.5708 0"/>
      </xacro:if>
      <xacro:if value="${axis == 'y'}">
        <xacro:v5_t_motor_mesh_visual xyz="0 0 0" rpy="1.5708 0 0" color="${color}"/>
        <xacro:v5_collision_cylinder radius="${v5_motor_radius}" length="${v5_motor_width}" xyz="0 0.05 0" rpy="1.5708 0 0"/>
      </xacro:if>
      <!-- Single cylindrical arm segment starts at this joint and ends at the next joint. -->
      <xacro:v5_visual_cylinder radius="${bar_radius}" length="${bar_length}" xyz="0 ${bar_length / 2.0} 0" rpy="1.5708 0 0" color="${color}"/>
      <xacro:v5_collision_cylinder radius="${bar_radius}" length="${bar_length}" xyz="0 ${bar_length / 2.0} 0" rpy="1.5708 0 0"/>
    </link>
  </xacro:macro>

  <xacro:macro name="v5_fixed_t_support" params="name color">
    <link name="${name}">
      <xacro:v5_simple_inertial mass="1.0"/>
      <!-- Passive T-shaped motor/bracket: visual reference only, no active DOF. -->
      <xacro:v5_t_motor_mesh_visual xyz="0 0 0" rpy="0 1.5708 0" color="${color}"/>
      <xacro:v5_collision_cylinder radius="${v5_motor_radius}" length="${v5_motor_width}" xyz="0.05 0 0" rpy="0 1.5708 0"/>
    </link>
  </xacro:macro>

  <xacro:macro name="v5_mount_link" params="name color">
    <link name="${name}">
      <xacro:v5_simple_inertial mass="3.0"/>
      <!-- Explicit mounting bracket: not a point mount. -->
      <xacro:v5_visual_box size="0.30 0.18 0.08" xyz="0 0 0" rpy="0 0 0" color="0.18 0.18 0.18 1"/>
      <xacro:v5_visual_box size="0.22 0.06 0.18" xyz="0 0 0.08" rpy="0 0 0" color="${color}"/>
      <xacro:v5_visual_cylinder radius="0.025" length="0.32" xyz="0 0 0.12" rpy="0 1.5708 0" color="0.03 0.03 0.03 1"/>
      <xacro:v5_collision_box size="0.30 0.18 0.18" xyz="0 0 0.05" rpy="0 0 0"/>
    </link>
  </xacro:macro>

  <xacro:macro name="v5_proxy_arm" params="side mount_y color">
    <xacro:v5_mount_link name="${side}_v5_link0" color="${color}"/>
    <joint name="${side}_v5_mount" type="fixed">
      <parent link="updown"/>
      <child link="${side}_v5_link0"/>
      <origin xyz="0 ${mount_y} ${v5_mount_z}" rpy="0 0 0"/>
    </joint>

    <xacro:v5_t_motor_link name="${side}_v5_link1" axis="z" mass="2.0" color="${color}"/>
    <joint name="${side}_v5_joint1" type="revolute">
      <parent link="${side}_v5_link0"/>
      <child link="${side}_v5_link1"/>
      <origin xyz="0 0 0.16" rpy="0 0 3.141592654"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="120" velocity="1.2"/>
    </joint>

    <xacro:v5_t_motor_with_bar_link name="${side}_v5_link2" axis="x" bar_length="${v5_upper_arm_length}" bar_radius="0.055" mass="4.5" color="${color}"/>
    <joint name="${side}_v5_joint2" type="revolute">
      <parent link="${side}_v5_link1"/>
      <child link="${side}_v5_link2"/>
      <origin xyz="0 -0.1 0.06" rpy="3.141592654 0 1.57079632"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.57079632" upper="1.57079632" effort="120" velocity="1.2"/>
    </joint>

    <xacro:v5_t_motor_with_bar_link name="${side}_v5_link3" axis="x" bar_length="${v5_forearm_length}" bar_radius="0.05" mass="3.6" color="${color}"/>
    <joint name="${side}_v5_joint3" type="revolute">
      <parent link="${side}_v5_link2"/>
      <child link="${side}_v5_link3"/>
      <!-- Elbow joint is at the end of upper arm, separated from shoulder J2. -->
      <origin xyz="-0.14 0.7 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-2.35619449" upper="2.35619449" effort="100" velocity="1.2"/>
    </joint>

    <xacro:v5_fixed_t_support name="${side}_v5_link3_passive_t" color="${color}"/>
    <joint name="${side}_v5_joint3_passive_t" type="fixed">
      <parent link="${side}_v5_link3"/>
      <child link="${side}_v5_link3_passive_t"/>
      <origin xyz="0.08 ${v5_motor_gap} 0" rpy="0 0 0"/>
    </joint>

    <xacro:v5_t_motor_link name="${side}_v5_link4" axis="y" mass="1.4" color="${color}"/>
    <joint name="${side}_v5_joint4" type="revolute">
      <parent link="${side}_v5_link3"/>
      <child link="${side}_v5_link4"/>
      <!-- Wrist joint4 is at the end of forearm, separated from elbow J3. -->
      <origin xyz="0 ${v5_forearm_length} ${v5_motor_gap}" rpy="3.141592654 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="60" velocity="1.5"/>
    </joint>

    <xacro:v5_t_motor_link name="${side}_v5_link5" axis="x" mass="1.0" color="${color}"/>
    <joint name="${side}_v5_joint5" type="revolute">
      <parent link="${side}_v5_link4"/>
      <child link="${side}_v5_link5"/>
      <origin xyz="0.0 -0.06 -0.08" rpy="0 1.57079632 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.57079632" upper="1.57079632" effort="60" velocity="1.5"/>
    </joint>

    <xacro:v5_t_motor_link name="${side}_v5_link6" axis="z" mass="1.0" color="${color}"/>
    <joint name="${side}_v5_joint6" type="revolute">
      <parent link="${side}_v5_link5"/>
      <child link="${side}_v5_link6"/>
      <origin xyz="0.06 -0.08 0" rpy="1.57079632 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="40" velocity="1.5"/>
    </joint>

    <link name="${side}_v5_tool0">
      <xacro:v5_simple_inertial mass="0.2"/>
      <xacro:v5_visual_box size="0.10 0.10 0.04" xyz="0 0.05 0" rpy="0 0 0" color="0.9 0.9 0.1 1"/>
    </link>
    <joint name="${side}_v5_tool0_fixed" type="fixed">
      <parent link="${side}_v5_link6"/>
      <child link="${side}_v5_tool0"/>
      <origin xyz="0 0.12 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:v5_proxy_arm side="left" mount_y="${v5_mount_y}" color="0.2 0.55 1.0 1"/>
  <xacro:v5_proxy_arm side="right" mount_y="${-v5_mount_y}" color="1.0 0.55 0.2 1"/>

  <xacro:alfa_robot_ros2_control
    name="alfa_robot"
    prefix="$(arg prefix)"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"
    sim_gazebo_classic="$(arg sim_gazebo_classic)"
    sim_gazebo="$(arg sim_gazebo)"
    simulation_controllers="$(arg simulation_controllers)"
    real_hardware_plugin="$(arg real_hardware_plugin)"
    canopen_profile_velocity="$(arg canopen_profile_velocity)"
    canopen_profile_accel="$(arg canopen_profile_accel)"/>

</robot>
