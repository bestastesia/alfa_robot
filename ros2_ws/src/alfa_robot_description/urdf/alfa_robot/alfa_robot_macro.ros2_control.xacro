<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="alfa_robot_ros2_control" params="
               name
               prefix
               use_mock_hardware:=true
               mock_sensor_commands:=true
               left_joint1_initial:=0.0
               left_joint2_initial:=0.0
               left_joint3_initial:=0.0
               left_joint4_initial:=0.0
               left_joint5_initial:=0.0
               left_joint6_initial:=0.0
               left_joint7_initial:=0.0
               right_joint1_initial:=0.0
               right_joint2_initial:=0.0
               right_joint3_initial:=0.0
               right_joint4_initial:=0.0
               right_joint5_initial:=0.0
               right_joint6_initial:=0.0
               right_joint7_initial:=0.0">

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="mock_sensor_commands">${mock_sensor_commands}</param>
      </hardware>

      <xacro:macro name="arm_control_joint" params="joint_name initial_value">
        <joint name="${prefix}${joint_name}">
          <command_interface name="position">
            <param name="min">-1.57</param>
            <param name="max">1.57</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">${initial_value}</param>
          </state_interface>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>

      <xacro:arm_control_joint joint_name="left_joint1" initial_value="${left_joint1_initial}"/>
      <xacro:arm_control_joint joint_name="left_joint2" initial_value="${left_joint2_initial}"/>
      <xacro:arm_control_joint joint_name="left_joint3" initial_value="${left_joint3_initial}"/>
      <xacro:arm_control_joint joint_name="left_joint4" initial_value="${left_joint4_initial}"/>
      <xacro:arm_control_joint joint_name="left_joint5" initial_value="${left_joint5_initial}"/>
      <xacro:arm_control_joint joint_name="left_joint6" initial_value="${left_joint6_initial}"/>
      <xacro:arm_control_joint joint_name="left_joint7" initial_value="${left_joint7_initial}"/>
      <xacro:arm_control_joint joint_name="right_joint1" initial_value="${right_joint1_initial}"/>
      <xacro:arm_control_joint joint_name="right_joint2" initial_value="${right_joint2_initial}"/>
      <xacro:arm_control_joint joint_name="right_joint3" initial_value="${right_joint3_initial}"/>
      <xacro:arm_control_joint joint_name="right_joint4" initial_value="${right_joint4_initial}"/>
      <xacro:arm_control_joint joint_name="right_joint5" initial_value="${right_joint5_initial}"/>
      <xacro:arm_control_joint joint_name="right_joint6" initial_value="${right_joint6_initial}"/>
      <xacro:arm_control_joint joint_name="right_joint7" initial_value="${right_joint7_initial}"/>
    </ros2_control>
  </xacro:macro>
</robot>
