        <mass value="0.763196071605449"/>
        <inertia ixx="0.00324062849151741" ixy="6.82020341217245E-19" ixz="-3.87057635370163E-16" iyy="0.0019198659327465" iyz="-1.80691312979497E-18" izz="0.00150433027221572"/>
