    <!-- right_ee_link (virtual end effector for MoveIt2 planning) -->
    <link name="${prefix}right_ee_link"/>

    <!-- left_ee_link (virtual end effector for MoveIt2 planning) -->
    <link name="${prefix}left_ee_link"/>

    <!-- END LINKS -->

    <!-- JOINTS -->
    <!-- base_joint fixes base_link to the environment -->
    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
    </joint>

    <!-- turn -->
    <joint name="${prefix}turn" type="continuous">
      <origin xyz="-0.007937 0 0.129" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}turn_link"/>
      <axis xyz="0 0 1"/>
    </joint>

    <!-- updown -->
    <joint name="${prefix}updown" type="prismatic">
      <origin xyz="-0.23547 0 0.57771" rpy="0 0 0"/>
      <parent link="${prefix}turn_link"/>
      <child link="${prefix}updown_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="1" effort="1000" velocity="1"/>
    </joint>

    <!-- plate (new joint) -->
    <joint name="${prefix}plate" type="prismatic">
      <origin xyz="0.42217 0 0.0325" rpy="0 0 0"/>
      <parent link="${prefix}updown_link"/>
      <child link="${prefix}plate_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="0.5" effort="1000" velocity="1000"/>
    </joint>

    <!-- rightjoint1 -->
    <joint name="${prefix}rightjoint1" type="prismatic">
      <origin xyz="-0.00487 -0.232101 0.232" rpy="0 0 0"/>
      <parent link="${prefix}updown_link"/>
      <child link="${prefix}rightjoint1_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="0.42" effort="1000" velocity="0.5"/>
    </joint>

    <!-- rightjoint2 -->
    <joint name="${prefix}rightjoint2" type="revolute">
      <origin xyz="0.67335 -0.10135 0.04" rpy="0 1.5708 0"/>
      <parent link="${prefix}rightjoint1_link"/>
      <child link="${prefix}rightjoint2_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="1000" velocity="0.5"/>
    </joint>

    <!-- rightjoint3 -->
    <joint name="${prefix}rightjoint3" type="revolute">
      <origin xyz="0.01 -0.0058 0.098" rpy="1.5708 -1.5708 0"/>
      <parent link="${prefix}rightjoint2_link"/>
      <child link="${prefix}rightjoint3_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57079632" upper="1.57079632" effort="1000" velocity="0.5"/>
    </joint>

