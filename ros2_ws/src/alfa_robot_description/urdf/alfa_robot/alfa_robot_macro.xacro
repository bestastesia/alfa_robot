        <mass value="0.983457322359293"/>
        <inertia ixx="0.00146324457982104" ixy="-1.07921279553368E-06" ixz="2.05978166819893E-07" iyy="0.00136637778648993" iyz="-3.51454994521712E-07" izz="0.00151815899256312"/>
