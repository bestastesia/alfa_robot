        <origin xyz="0.00998125570987396 -0.0501508012211525 0.0836125943851177" rpy="0 0 0"/>
        <mass value="0.924094586385747"/>
        <inertia ixx="0.00138886172299487" ixy="-9.60798584640597E-07" ixz="-2.47998998359295E-07" iyy="0.00126018297864274" iyz="6.56045281312999E-07" izz="0.0014853923148985"/>
