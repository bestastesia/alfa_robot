        <mass value="0.0884229444440941"/>
        <inertia ixx="0.000108966100127413" ixy="4.24530017226163E-12" ixz="1.30809093461559E-12" iyy="1.08349581479197E-05" iyz="1.58450016026868E-10" izz="0.000108016955483713"/>
