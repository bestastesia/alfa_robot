      <inertial>
        <origin xyz="-0.000765897194240361 5.34294830600857E-16 -0.00285836724227106" rpy="0 0 0"/>
        <mass value="0.296061195729235"/>
        <inertia ixx="0.000229195879552691" ixy="-5.34979264059518E-18" ixz="-7.69967406090194E-06" iyy="0.000231259000999259" iyz="8.30310887470795E-18" izz="0.000202523426202246"/>
