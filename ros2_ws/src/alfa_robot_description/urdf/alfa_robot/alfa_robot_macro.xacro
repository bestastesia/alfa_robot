    <joint name="${prefix}rightjoint4" type="revolute">
      <origin xyz="0.3418 0.01 -0.082" rpy="-1.5708 0 -1.5708"/>
      <parent link="${prefix}rightjoint3_link"/>
      <child link="${prefix}rightjoint4_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="1000" velocity="0.5"/>
    </joint>

    <!-- rightjoint5 (new joint for 6DOF, Y-axis mirror of leftjoint5) -->
    <joint name="${prefix}rightjoint5" type="revolute">
      <origin xyz="0.01 0.0022 0.098" rpy="1.5708 -1.5708 0"/>
      <parent link="${prefix}rightjoint4_link"/>
      <child link="${prefix}rightjoint5_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57079632" upper="1.57079632" effort="1000" velocity="0.5"/>
    </joint>

    <!-- rightjoint6 (new joint for end effector extension, Y-axis mirror of leftjoint6) -->
    <joint name="${prefix}rightjoint6" type="prismatic">
      <origin xyz="0.13 0 0.1435" rpy="-1.5708 0 0"/>
      <parent link="${prefix}rightjoint5_link"/>
      <child link="${prefix}rightjoint6_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="0.15" effort="0" velocity="0"/>
    </joint>

    <!-- right_ee_joint (virtual fixed joint for MoveIt2 end effector) -->
    <joint name="${prefix}right_ee_joint" type="fixed">
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <parent link="${prefix}rightjoint6_link"/>
      <child link="${prefix}right_ee_link"/>
    </joint>

    <!-- leftjoint1 -->
    <joint name="${prefix}leftjoint1" type="prismatic">
      <origin xyz="-0.00487 0.232101 0.232" rpy="0 0 0"/>
      <parent link="${prefix}updown_link"/>
      <child link="${prefix}leftjoint1_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="0.42" effort="1000" velocity="0.5"/>
    </joint>

    <!-- rightjoint2 -->
    <joint name="${prefix}leftjoint2" type="revolute">
      <origin xyz="0.67335 0.10135 0.04" rpy="0 1.5708 0"/>
      <parent link="${prefix}leftjoint1_link"/>
      <child link="${prefix}leftjoint2_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="1000" velocity="0.5"/>
    </joint>

    <!-- rightjoint3 -->
    <joint name="${prefix}leftjoint3" type="revolute">
      <origin xyz="0.01 0.0058 0.098" rpy="-1.5708 -1.5708 0"/>
      <parent link="${prefix}leftjoint2_link"/>
      <child link="${prefix}leftjoint3_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57079632" upper="1.57079632" effort="1000" velocity="0.5"/>
    </joint>

    <!-- rightjoint4 -->
    <joint name="${prefix}leftjoint4" type="revolute">
      <origin xyz="0.3418 -0.01 -0.082" rpy="1.5708 0 1.5708"/>
      <parent link="${prefix}leftjoint3_link"/>
      <child link="${prefix}leftjoint4_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="1000" velocity="0.5"/>
    </joint>

    <!-- leftjoint5 (new joint for 6DOF) -->
    <joint name="${prefix}leftjoint5" type="revolute">
      <origin xyz="0.01 -0.0022 0.098" rpy="-1.5708 -1.5708 0"/>
      <parent link="${prefix}leftjoint4_link"/>
      <child link="${prefix}leftjoint5_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57079632" upper="1.57079632" effort="1000" velocity="0.5"/>
    </joint>

    <!-- leftjoint6 (new joint for end effector extension) -->
    <joint name="${prefix}leftjoint6" type="prismatic">
      <origin xyz="0.13 0 0.1435" rpy="1.5708 0 0"/>
      <parent link="${prefix}leftjoint5_link"/>
      <child link="${prefix}leftjoint6_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="0.15" effort="0" velocity="0"/>
    </joint>

    <!-- left_ee_joint (virtual fixed joint for MoveIt2 end effector) -->
    <joint name="${prefix}left_ee_joint" type="fixed">
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <parent link="${prefix}leftjoint6_link"/>
      <child link="${prefix}left_ee_link"/>
    </joint>

    <!-- camera -->
    <joint name="${prefix}camera" type="fixed">
      <origin xyz="0.51384 0 0.07785" rpy="0 0 0"/>
      <parent link="${prefix}updown_link"/>
      <child link="${prefix}camera_link"/>
    </joint>

    <!-- lidar -->
    <joint name="${prefix}lidar" type="fixed">
      <origin xyz="0.46082 0 0.13841" rpy="0 0 0"/>
      <parent link="${prefix}updown_link"/>
      <child link="${prefix}lidar_link"/>
    </joint>

    <!-- END JOINTS -->

  </xacro:macro>
</robot>
