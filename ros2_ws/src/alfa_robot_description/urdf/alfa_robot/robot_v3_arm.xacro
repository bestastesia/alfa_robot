<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="robot_v3_arm_link" params="name mesh">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh}"/>
        </geometry>
        <material name="robot_v3_arm_white">
          <color rgba="0.82 0.82 0.82 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="robot_v3_arm_joint" params="name parent child xyz rpy axis">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
      <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="robot_v3_arm" params="prefix parent mount_xyz mirrored:=false">
    <xacro:property name="variant" value="${'right' if mirrored else 'left'}"/>
    <xacro:property name="mesh_root" value="package://alfa_robot_description/meshes/robot_v3_0_2/${variant}"/>

    <xacro:robot_v3_arm_link name="${prefix}_arm_base" mesh="${mesh_root}/base_link.stl"/>
    <joint name="${prefix}_arm_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_arm_base"/>
      <origin xyz="${mount_xyz}" rpy="0 0 3.14159265"/>
    </joint>

    <xacro:unless value="${mirrored}">
      <xacro:robot_v3_arm_link name="${prefix}_joint1" mesh="${mesh_root}/Link_1.stl"/>
      <xacro:robot_v3_arm_link name="${prefix}_joint2" mesh="${mesh_root}/Link_2.stl"/>
      <xacro:robot_v3_arm_link name="${prefix}_joint3" mesh="${mesh_root}/Link_3.stl"/>
      <xacro:robot_v3_arm_link name="${prefix}_joint4" mesh="${mesh_root}/Link_4.stl"/>
      <xacro:robot_v3_arm_link name="${prefix}_joint5" mesh="${mesh_root}/Link_5.stl"/>
      <xacro:robot_v3_arm_link name="${prefix}_joint6" mesh="${mesh_root}/Link_6.stl"/>
      <xacro:robot_v3_arm_link name="${prefix}_joint7" mesh="${mesh_root}/Link_7.stl"/>

      <xacro:robot_v3_arm_joint name="${prefix}_joint1" parent="${prefix}_arm_base" child="${prefix}_joint1" xyz="0 0 0.018" rpy="0 0 3.14159265" axis="0 0 1"/>
      <xacro:robot_v3_arm_joint name="${prefix}_joint2" parent="${prefix}_joint1" child="${prefix}_joint2" xyz="-0.03395348 -0.01941469 0.11" rpy="-1.57079633 0 2.09022451" axis="0 0 1"/>
      <xacro:robot_v3_arm_joint name="${prefix}_joint3" parent="${prefix}_joint2" child="${prefix}_joint3" xyz="-0.23198447 -0.08184869 -0.03729999" rpy="0 1.57079633 -2.80240802" axis="0 0 1"/>
      <xacro:robot_v3_arm_joint name="${prefix}_joint4" parent="${prefix}_joint3" child="${prefix}_joint4" xyz="-0.07756491 -0.15036183 0.147" rpy="1.57079632 -1.22828075 -1.71595129" axis="0 0 1"/>
      <xacro:robot_v3_arm_joint name="${prefix}_joint5" parent="${prefix}_joint4" child="${prefix}_joint5" xyz="0.04597995 -0.00135805 -0.05" rpy="-1.57079589 -1.43390621 -1.60032347" axis="0 0 1"/>
      <xacro:robot_v3_arm_joint name="${prefix}_joint6" parent="${prefix}_joint5" child="${prefix}_joint6" xyz="0.04549984 0.00012564 0.28300003" rpy="-1.57079667 -1.54154524 -1.5680338" axis="0 0 1"/>
      <xacro:robot_v3_arm_joint name="${prefix}_joint7" parent="${prefix}_joint6" child="${prefix}_joint7" xyz="0.06585468 0.00164675 -0.04498124" rpy="-0.02526825 1.56803419 0" axis="0 0 1"/>
    </xacro:unless>

    <xacro:if value="${mirrored}">
      <xacro:robot_v3_arm_link name="${prefix}_joint1" mesh="${mesh_root}/Link_1.stl"/>
      <xacro:robot_v3_arm_link name="${prefix}_joint2" mesh="${mesh_root}/Link_2.stl"/>
      <xacro:robot_v3_arm_link name="${prefix}_joint3" mesh="${mesh_root}/Link_3.stl"/>
      <xacro:robot_v3_arm_link name="${prefix}_joint4" mesh="${mesh_root}/Link_4.stl"/>
      <xacro:robot_v3_arm_link name="${prefix}_joint5" mesh="${mesh_root}/Link_5.stl"/>
      <xacro:robot_v3_arm_link name="${prefix}_joint6" mesh="${mesh_root}/Link_6.stl"/>
      <xacro:robot_v3_arm_link name="${prefix}_joint7" mesh="${mesh_root}/Link_7.stl"/>

      <xacro:robot_v3_arm_joint name="${prefix}_joint1" parent="${prefix}_arm_base" child="${prefix}_joint1" xyz="0 0 0.018" rpy="0 0 -3.14159265" axis="0 0 -1"/>
      <xacro:robot_v3_arm_joint name="${prefix}_joint2" parent="${prefix}_joint1" child="${prefix}_joint2" xyz="-0.03395348 0.01941469 0.11" rpy="1.57079633 0 -2.09022451" axis="0 0 -1"/>
      <xacro:robot_v3_arm_joint name="${prefix}_joint3" parent="${prefix}_joint2" child="${prefix}_joint3" xyz="-0.23198447 0.08184869 -0.03729999" rpy="0 1.57079633 2.80240802" axis="0 0 -1"/>
      <xacro:robot_v3_arm_joint name="${prefix}_joint4" parent="${prefix}_joint3" child="${prefix}_joint4" xyz="-0.07756491 0.15036183 0.147" rpy="-1.57079632 -1.22828075 1.71595129" axis="0 0 -1"/>
      <xacro:robot_v3_arm_joint name="${prefix}_joint5" parent="${prefix}_joint4" child="${prefix}_joint5" xyz="0.04597995 0.00135805 -0.05" rpy="1.57079589 -1.43390621 1.60032347" axis="0 0 -1"/>
      <xacro:robot_v3_arm_joint name="${prefix}_joint6" parent="${prefix}_joint5" child="${prefix}_joint6" xyz="0.04549984 -0.00012564 0.28300003" rpy="1.57079667 -1.54154524 1.5680338" axis="0 0 -1"/>
      <xacro:robot_v3_arm_joint name="${prefix}_joint7" parent="${prefix}_joint6" child="${prefix}_joint7" xyz="0.06585468 -0.00164675 -0.04498124" rpy="0.02526825 1.56803419 0" axis="0 0 -1"/>
    </xacro:if>

    <link name="${prefix}_tool0"/>
    <joint name="${prefix}_tool0_fixed" type="fixed">
      <parent link="${prefix}_joint7"/>
      <child link="${prefix}_tool0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
